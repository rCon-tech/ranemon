{
  "name": "ranemon-save-api",
  "private": true,
  "type": "module",
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "esbuild ../src/lib/online/server.ts --bundle --format=esm --platform=node --target=node20 --outfile=gen/battle.js",
    "typecheck": "tsc --noEmit",
    "local": "esbuild local.ts --bundle --platform=node --format=esm --outfile=gen/local.js && node gen/local.js"
  }
}
